use crate::window_renderer::{ Text , TypeOfBorder};
use crate::sub_win::TextType;
use crate::window::Window;
use super::widgets;
use crate::storage::Node;
use super::super::style::TextStyle;
use node_proc_macro::Node;

#[derive(Debug, Node)]
struct Div {
    texts: Vec<Text>,
    type_of_border: TypeOfBorder,
}

impl Div {
    fn new(texts: &[Text], type_of_border: TypeOfBorder) -> Div {
        Self {
            texts: texts.try_into().expect("Error while converting types"),
            type_of_border,
        }
    }
}

impl widgets::Widget for Div {
    fn render(&self) -> Vec<Text> {
        let window = Window::new(self.texts.iter().map(|x| TextType::Text(x)).collect())
    }
}

